# Notion Integration Token
# https://www.notion.so/my-integrations から取得
NOTION_TOKEN=your-notion-integration-token

# Feeder Database ID（RSSフィード設定用）
FEEDER_DB_ID=your-feeder-database-id

# Reader Database ID（記事保存先）
READER_DB_ID=your-reader-database-id

# 記事収集の期間（デフォルト: 7日）
ARTICLE_LOOKBACK_DAYS=7

# ローカルフィルタ（ルールベース）の閾値
FILTER_MIN_SCORE=40
FILTER_RECOMMENDED_SCORE=70
FILTER_TUTORIAL_PENALTY=15
